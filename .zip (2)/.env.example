# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Get this from Google Cloud Console -> APIs & Services -> Credentials
# Make sure "Places API (New)" is enabled on your project/billing account.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Only needed if you use the --enrich flag (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
